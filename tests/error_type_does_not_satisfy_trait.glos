Foo :: trait {
    a: (_: s32)     // Wrong number of arguments
    b: (_: bool)    // Wrong argument type
    c: () -> string // Wrong Return type
    d: ()           // Wrong receiver type
}

Bar :: distinct s64

main :: () {
    Foo(Bar(69))
}

impl Bar for Foo {
    a :: (this: Self) {}
    b :: (this: Self, _: string) {}
    c :: (this: Self) {}
    d :: (this: &Self) {}
}
