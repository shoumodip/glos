Foo :: trait {
    a: ()           // Undefined
    b: (_: s32)     // Wrong number of arguments
    c: (_: bool)    // Wrong argument type
    d: () -> string // Wrong Return type
    e: ()           // Wrong receiver type
}

Bar :: distinct s64

main :: () {
    Foo(Bar(69))
}

impl Bar for Foo {
    b :: (this: Self) {}
    c :: (this: Self, _: string) {}
    d :: (this: Self) {}
    e :: (this: &Self) {}
}
