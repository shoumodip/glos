main :: () {
    for i := 0; i < 10; i += 1 {
		defer {
            write("Defer ")
            println(i)
        }

		if i == 2 {
			continue
		}

		if i == 5 {
			break
		}

		println(i)
	}
}

write :: (s: string) {
    for i := 0; i < s.count; i += 1 {
        extern { putchar :: (c: s32) -> s32 }
        putchar(s32(s[i]))
    }
}
