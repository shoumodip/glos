Writer :: trait {
    write: (bytes: []char)
}

greet :: (w: Writer) {
    w.write([]char("Hello, world!\n"))
}

File :: distinct os.File

impl File for Writer {
    write :: (this: Self, bytes: []char) {
        C.fwrite(rawptr(bytes.data), sizeof(char), u64(bytes.count), os.File(this))
    }
}

main :: () {
    greet(File(os.stdout))
}

C  :: #import "C"
os :: #import "os"
