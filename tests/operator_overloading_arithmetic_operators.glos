Int32 :: struct {
    x: s32
}

impl Int32 for Add {
    add :: (lhs: Self, rhs: Self) -> Self {
        lhs.x += rhs.x
        return lhs
    }
}

impl Int32 for Sub {
    sub :: (lhs: Self, rhs: Self) -> Self {
        lhs.x -= rhs.x
        return lhs
    }
}

impl Int32 for Mul {
    mul :: (lhs: Self, rhs: Self) -> Self {
        lhs.x *= rhs.x
        return lhs
    }
}

impl Int32 for Div {
    div :: (lhs: Self, rhs: Self) -> Self {
        lhs.x /= rhs.x
        return lhs
    }
}

impl Int32 for Mod {
    mod :: (lhs: Self, rhs: Self) -> Self {
        lhs.x %= rhs.x
        return lhs
    }
}

impl Int32 for Neg {
    neg :: (lhs: Self) -> Self {
        lhs.x = -lhs.x
        return lhs
    }
}

impl Int32 for Equal {
    equal :: (lhs: Self, rhs: Self) -> bool {
        return lhs.x == rhs.x
    }
}

impl Int32 for Ordered {
    order :: (lhs: Self, rhs: Self) -> Ordering {
        if lhs.x < rhs.x {
            return .LT
        }

        if lhs.x > rhs.x {
            return .GT
        }

        return .EQ
    }
}

main :: () {
    a := Int32 {10}
    b := Int32 {3}

    println(a + b)
    println(a - b)
    println(a * b)
    println(a / b)
    println(a % b)
    println(-a)

    c := a
    c += b
    println(c)

    c = a
    c -= b
    println(c)

    c = a
    c *= b
    println(c)

    c = a
    c /= b
    println(c)

    c = a
    c %= b
    println(c)

    println(a)
    println(a != b)

    println(b < a)
    println(b <= a)

    println(a > b)
    println(a >= b)

    println(a <= a)
    println(a >= a)
}
