Int :: struct {
    v: s64
}

operator + :: (this: Int, that: Int, location := #caller_location) -> Int {
    print("\{location} ")
    this.v += that.v
    return this
}

operator - :: (this: Int, that: Int, location := #caller_location) -> Int {
    print("\{location} ")
    this.v -= that.v
    return this
}

main :: () {
    a := Int {34}
    b := Int {35}
    c := a + b
    println(c)
    println(-c)
}
