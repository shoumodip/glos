a: Foo : A(69)
main :: () {
    #if a == {
    case A
        other()
        println(a)
        x: A = a
    }
}

b: Foo : B("Urmom")
other :: () {
    #if b == B {
        println(b)
        x: B = b
    }
}

// Details
Foo :: trait {
    foo: ()
}

A   :: distinct s64

impl A {
    foo :: (a: Self) { println("A: ", a) }
}

B   :: distinct string

impl B {
    foo :: (b: Self) { println("B: ", b) }
}
