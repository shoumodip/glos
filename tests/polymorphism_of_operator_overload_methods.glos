Array :: struct($T: Type, $N: s64) {
    items: [N]T
}

impl &Array($T, $N) {
    index :: (a: Self, n: s64, assign: bool) -> &T {
        assert(n < a.items.count)
        return &a.items[n]
    }
}

main :: () {
    xs: Array(s64, 4)
    xs[0] = 69
    xs[1] = 420
    xs[2] = 1337
    println(xs)
}
