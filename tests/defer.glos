foo :: () -> s64 {
	println("foo()")
	return 69
}

bar :: () -> s64 {
	defer println("defer")
	return foo()
}

main :: () {
	bar()
}

println :: (s: string) {
    extern {
        putchar :: (c: s32) -> s32
    }

    for i := 0; i < s.count; i += 1 {
        putchar(s32(s[i]))
    }

    putchar(s32('\n'))
}
