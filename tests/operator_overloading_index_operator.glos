Table :: struct {
    items: [64]struct {
        key:   string
        value: s64
    }
    count: s64
}

main :: () {
    xs: Table
    xs["Foo"] = 69
    println(xs["Foo"])
    println(xs["Bar"])
}

impl Table {
    index :: (t: &Self, key: string, assign: bool, location := #caller_location) -> &s64 {
        for i := 0; i < t.count; i += 1 {
            it := &t.items[i]
            if it.key == key {
                return &it.value
            }
        }

        if !assign {
            eprintln("\{location} Key '\{key}' does not exist")
            os.exit(1)
        }

        if t.count >= t.items.count {
            eprintln("\{location} Table is out of memory")
            os.exit(1)
        }

        it := &t.items[t.count]
        t.count += 1

        it.key = key
        return &it.value

        os :: #import "os"
    }
}
