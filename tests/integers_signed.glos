main :: () {
    a := s8(69)
    b := s16(420)
    c := s32(1337)
    d := s64(80085)

    // Basics
    println(a)
    println(b)
    println(c)
    println(d)

    // Sizes
    println(sizeof(a))
    println(sizeof(b))
    println(sizeof(c))
    println(sizeof(d))

    // Comparisons
    println(u64(1) > 0)
    println(u64(1) > u64(s64(-1)))
}
