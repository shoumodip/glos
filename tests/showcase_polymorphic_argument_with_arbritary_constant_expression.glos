foo :: ($A: Any) {
    println(A)
}

bar :: ($A: &s32) {
    assert(A == &x)
}

baz :: ($A: ()) {
    assert(A == main)
}

x: s32

main :: () {
    foo(69)
    foo(s64)
    foo(union { s64; string }     ("Hello, world!"))
    foo(struct { x: s64; y: s64 } {420, 1337})
    foo([]char {'H', 'i', '!'})
    bar(&x)
    baz(main)
}
