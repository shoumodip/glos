Array :: struct {
    items: [64]s64
}

main :: () {
    xs: Array
    xs[0] = 69
    println(xs[..3])
}

impl Array {
    index :: (a: &Self, index: s64, assign: bool, location := #caller_location) -> &s64 {
        assert(
            index < a.items.count,
            "Index \{index} is out of bounds in Array of length of \{a.items.count}",
            location = location
        )
        return &a.items[index]
    }

    range :: (a: &Self, begin := 0, end := -1, location := #caller_location) -> []s64 {
        if end == -1 {
            end = a.items.count
        }

        assert(
            begin <= end,
            "Range (\{begin}..\{end}) is invalid: Beginning of range is more than end",
            location = location
        )

        assert(
            end <= a.items.count,
            "Range (\{begin}..\{end}) is out of bounds in Array of length \{a.items.count}",
            location = location
        )
        return a.items[begin..end]
    }
}
