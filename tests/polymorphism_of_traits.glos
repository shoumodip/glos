My_Trait :: trait($T: Type) {
    my_method: (that: T) -> T
}

Foo :: struct {
    x: s64
}

Bar :: struct {
    x: string
}

impl Foo {
    my_method :: (this: Self, that: Foo) -> Foo {
        return this
    }
}

impl Bar {
    my_method :: (this: Self, that: Bar) -> Bar {
        return this
    }
}

main :: () {
    My_Trait(Foo {69})
    My_Trait(Bar {"Urmom"})
}
