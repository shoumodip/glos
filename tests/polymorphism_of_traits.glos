My_Trait :: trait($T: Type) {
    my_method: (that: T) -> T
}

Foo :: struct {
    x: s64
}

Bar :: struct {
    x: string
}

my_method :: (this: Foo, that: Foo) -> Foo {
    return this
}

my_method :: (this: Bar, that: Bar) -> Bar {
    return this
}

main :: () {
    My_Trait(Foo {69})
    My_Trait(Bar {"Urmom"})
}
