My_Trait :: trait($T: Type) {
    my_method: (other: T) -> T
}

Foo :: struct {
    x: s64
}

Bar :: struct {
    x: string
}

impl Foo for My_Trait {
    my_method :: (self: Self, other: Self) -> Self {
        return self
    }
}

impl Bar for My_Trait {
    my_method :: (self: Self, other: Self) -> Self {
        return self
    }
}

main :: () {
    My_Trait(Foo {69})
    My_Trait(Bar {"Urmom"})
}
