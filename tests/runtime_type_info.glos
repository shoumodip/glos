main :: () {
    // Primitives
    {
        write_type(bool)
        write_type(char)

        write_type(s8)
        write_type(s16)
        write_type(s32)
        write_type(s64)

        write_type(u8)
        write_type(u16)
        write_type(u32)
        write_type(u64)

        write_type(f32)
        write_type(f64)

        write_type(rawptr)
        write_type(string)
    }

    // Functions
    {
        write_type(())
        write_type((_: string))
        write_type((_: string, _: rawptr))
        write_type(() -> s32)
        write_type((_: s32) -> s32)
        write_type((_: s32, _: u8) -> s32)
        write_type(() -> s32, bool)
        write_type((_: s32) -> s32, bool)
        write_type((_: s32, _: u8) -> s32, bool)
        write_type(() -> ((_: s32) -> bool))
    }

    // Enumerations
    {
        write_type(enum {
            Foo
            Bar
            Baz = 69
            Urmom
        })
    }

    // Traits
    {
        write_type(trait {
            read: (a: string) -> s32
            show: (a: s32) -> string
        })
    }

    // Unions
    {
        write_type(union {
            s32
            string
            (_: string) -> s64
        })
    }

    // Structures
    {
        write_type(struct {
            x, y: s32
            urmom: string
        })
    }

    // Arrays
    {
        write_type([69]string)
        write_type([69][420]u8)
    }

    // Dynamic Arrays
    {
        write_type([..]string)
    }

    // Slices
    {
        write_type([]string)
    }

    // Recursive
    {
        Node :: struct {
            name: string
            next: &Node
        }

        write_type(Node)
    }
}

write_type :: (ti: Type) {
    write_type(ti)
    write_string("\n")

    write_type :: (ti: Type) {
        #static depth: s64
        #static tm: [1024]Type
        #static tm_count: s64
        for i := 0; i < tm_count; i += 1 {
            if tm[i] == ti {
                write_string("<Recursive>")
                return
            }
        }

        tm[tm_count] = ti
        tm_count += 1
        defer tm_count -= 1

        variant := ti.variant
        if variant == {
        case Type_Info_Boolean
            write_string("bool")

        case Type_Info_Character
            write_string("char")

        case Type_Info_Integer
            if variant.signed {
                write_string("s")
            } else {
                write_string("u")
            }
            write_s64(ti.size * 8)

        case Type_Info_Float
            write_string("f")
            write_s64(ti.size * 8)

        case Type_Info_Pointer
            if variant.underlying != null {
                write_string("&")
                write_type(variant.underlying)
            } else {
                write_string("rawptr")
            }

        case Type_Info_Function
            write_string("(")
            for i := 0; i < variant.args.count; i += 1 {
                if i > 0 {
                    write_string(", ")
                }
                write_type(variant.args[i])
            }
            write_string(")")

            if variant.returns.count > 0 {
                write_string(" -> ")
                if variant.returns.count > 1 {
                    write_string("(")
                }

                for i := 0; i < variant.returns.count; i += 1 {
                    if i > 0 {
                        write_string(", ")
                    }
                    write_type(variant.returns[i])
                }

                if variant.returns.count > 1 {
                    write_string(")")
                }
            }

        case Type_Info_Enumeration
            write_string("enum ")
            write_type(variant.underlying)
            write_string(" {")
            if variant.names.count != 0 {
                write_string("\n")
                depth += 1
                for i := 0; i < variant.names.count; i += 1 {
                    write_indent(depth)
                    write_string(variant.names[i])
                    write_string(" = ")
                    write_s64(variant.values[i])
                    write_string("\n")
                }
                depth -= 1
                write_indent(depth)
            }
            write_string("}")

        case Type_Info_Trait
            write_string("trait {")
            if variant.names.count != 0 {
                write_string("\n")
                depth += 1
                for i := 0; i < variant.names.count; i += 1 {
                    write_indent(depth)
                    write_string(variant.names[i])
                    write_string(": ")
                    write_type(variant.types[i])
                    write_string("\n")
                }
                depth -= 1
                write_indent(depth)
            }
            write_string("}")

        case Type_Info_Union
            write_string("union {")
            if variant.variants.count != 0 {
                write_string("\n")
                depth += 1
                for i := 0; i < variant.variants.count; i += 1 {
                    write_indent(depth)
                    write_type(variant.variants[i])
                    write_string("\n")
                }
                depth -= 1
                write_indent(depth)
            }
            write_string("}")

        case Type_Info_Structure
            write_string("struct {")
            if variant.names.count != 0 {
                write_string("\n")
                depth += 1
                for i := 0; i < variant.names.count; i += 1 {
                    write_indent(depth)
                    write_string(variant.names[i])
                    write_string(": ")
                    write_type(variant.types[i])
                    write_string(" // offset = ")
                    write_s64(variant.offsets[i])
                    write_string("\n")
                }
                depth -= 1
                write_indent(depth)
            }
            write_string("}")

        case Type_Info_Array
            write_string("[")
            write_s64(variant.count)
            write_string("]")
            write_type(variant.underlying)

        case Type_Info_Dynamic_Array
            write_string("[..]")
            write_type(variant.underlying)

        case Type_Info_Slice
            write_string("[]")
            write_type(variant.underlying)

        case Type_Info_String
            write_string("string")

        case null
            unreachable()
        }
    }

    write_string :: (s: string) {
        C.printf("%.*s".data, s32(s.count), s.data)
    }

    write_indent :: (n: s64) {
        C.printf("%*s".data, s32(n * 4), "".data)
    }

    write_s64 :: (n: s64) {
        C.printf("%ld".data, n)
    }

    C :: #import "C"
}
