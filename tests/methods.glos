Counter :: struct {
    n: s64
}

impl Counter {
    get :: (c: &Self) -> s64 {
        c.n += 1
        return c.n - 1
    }
}

main :: () {
    c: Counter
    println(c.get())
    println(c.get())

    f := c.get
    println(f(&c))
    println(f(&c))

    g :: Counter.get
    println(g(&c))
    println(g(&c))
}
