main :: () {
    a := Vec2 {34, 200}
    b := Vec2 {35, 220}
    c := Vec3 {34, 200, 600}
    d := Vec3 {35, 220, 737}

    a, c += b, d
    println(a)
    println(c)
}

Vec2 :: struct {
    x, y: s32
}

Vec3 :: struct {
    x, y, z: s32
}

impl Vec2 for Add {
    add :: (lhs: Self, rhs: Self) -> Self {
        lhs.x += rhs.x
        lhs.y += rhs.y
        return lhs
    }
}

impl Vec3 for Add {
    add :: (lhs: Self, rhs: Self) -> Self {
        lhs.x += rhs.x
        lhs.y += rhs.y
        lhs.z += rhs.z
        return lhs
    }
}
