alloc_s64s :: (n: s64) -> []s64 {
    extern {
        malloc :: (size: s64) -> rawptr
    }

    ptr := &s64(malloc(n * sizeof(s64)))
    return ptr[0..n]
}

main :: () {
    xs := alloc_s64s(5)
    for i := 0; i < xs.count; i = i + 1 {
        xs[i] = i * 2
    }

    println(xs[2])
    println(xs[5])
}
