panic :: (message: ...Any, location := #caller_location) {
    if message.count == 0 {
        eprintln("\{location}")
    } else {
        eprint("\{location} ")
        eprintln(...message)
    }

    C.fflush(os.stdout)
    C.fflush(os.stderr)
    C.abort()
}

assert :: (cond: bool, message: ...Any, location := #caller_location) {
    if !cond {
        if message.count == 0 {
            eprintln("\{location} Assertion Failed")
        } else {
            eprint("\{location} Assertion Failed: ")
            eprintln(...message)
        }

        C.fflush(os.stdout)
        C.fflush(os.stderr)
        C.abort()
    }
}

todo :: (message: ...Any, location := #caller_location) {
    if message.count == 0 {
        eprintln("\{location} TODO")
    } else {
        eprint("\{location} TODO: ")
        eprintln(...message)
    }

    C.fflush(os.stdout)
    C.fflush(os.stderr)
    C.abort()
}

unreachable :: (message: ...Any, location := #caller_location) {
    if message.count == 0 {
        eprintln("\{location} Unreachable")
    } else {
        eprint("\{location} Unreachable: ")
        eprintln(...message)
    }

    C.fflush(os.stdout)
    C.fflush(os.stderr)
    C.abort()
}

impl string {
    equal :: (lhs: Self, rhs: Self) -> bool {
        return lhs.count == rhs.count && C.memcmp(rawptr(lhs.data), rawptr(rhs.data), u64(lhs.count)) == 0
    }

    order :: (lhs: Self, rhs: Self) -> Ordering {
        n := lhs.count
        if n > rhs.count {
            n = rhs.count
        }

        diff := C.memcmp(rawptr(lhs.data), rawptr(rhs.data), u64(n))
        if diff < 0 {
            return .LT
        }

        if diff > 0 {
            return .GT
        }

        if lhs.count < rhs.count {
            return .LT
        }

        if lhs.count > rhs.count {
            return .GT
        }

        return .EQ
    }
}

New :: ($T: Type, n := 1, a := &arena.default) -> &T {
    return &T(a.alloc(n * sizeof(T)))
}

New_Array :: ($T: Type, n: s64, a := &arena.default) -> []T {
    return (&T(a.alloc(n * sizeof(T))))[..n]
}
