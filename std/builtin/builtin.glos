panic :: (message: ...Any, location := #caller_location) {
    if message.count == 0 {
        eprintln("\{location}")
    } else {
        eprint("\{location} ")
        eprintln(...message)
    }

    C.fflush(os.stdout)
    C.fflush(os.stderr)
    C.abort()
}

assert :: (cond: bool, message: ...Any, location := #caller_location) {
    if !cond {
        if message.count == 0 {
            eprintln("\{location} Assertion Failed")
        } else {
            eprint("\{location} Assertion Failed: ")
            eprintln(...message)
        }

        C.fflush(os.stdout)
        C.fflush(os.stderr)
        C.abort()
    }
}

todo :: (message: ...Any, location := #caller_location) {
    if message.count == 0 {
        eprintln("\{location} TODO")
    } else {
        eprint("\{location} TODO: ")
        eprintln(...message)
    }

    C.fflush(os.stdout)
    C.fflush(os.stderr)
    C.abort()
}

unreachable :: (message: ...Any, location := #caller_location) {
    if message.count == 0 {
        eprintln("\{location} Unreachable")
    } else {
        eprint("\{location} Unreachable: ")
        eprintln(...message)
    }

    C.fflush(os.stdout)
    C.fflush(os.stderr)
    C.abort()
}

compare :: (this: string, that: string) -> Ordering {
    n := this.count
    if n > that.count {
        n = that.count
    }

    diff := C.memcmp(rawptr(this.data), rawptr(that.data), u64(n))
    if diff < 0 {
        return .LT
    }

    if diff > 0 {
        return .GT
    }

    if this.count < that.count {
        return .LT
    }

    if this.count > that.count {
        return .GT
    }

    return .EQ
}

New :: ($T: Type, n := 1, a := &arena.default) -> &T {
    return &T(a.alloc(n * sizeof(T)))
}

New_Array :: ($T: Type, n: i64, a := &arena.default) -> []T {
    return (&T(a.alloc(n * sizeof(T))))[..n]
}
