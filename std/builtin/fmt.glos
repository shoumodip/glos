#private ...

write_type :: (w: Writer, t: Type) {
    if t == null {
        w.write([]char("null"))
        return
    }

    if t.name.count != 0 {
        w.write([]char(t.name))
        return
    }

    v := t.variant
    if v == {
    case Type_Info_Boolean
        w.write([]char("bool"))

    case Type_Info_Character
        w.write([]char("char"))

    case Type_Info_Integer
        if v.signed {
            w.write([]char("i"))
        } else {
            w.write([]char("u"))
        }
        wprint(w, t.size * 8)

    case Type_Info_Pointer
        if v.underlying != null {
            w.write([]char("&"))
            write_type(w, v.underlying)
        } else {
            w.write([]char("rawptr"))
        }

    case Type_Info_Function
        w.write([]char("("))
        for i := 0; i < v.args.count; i += 1 {
            if i > 0 {
                w.write([]char(", "))
            }
            write_type(w, v.args[i])
        }
        w.write([]char(")"))

        if v.returns.count > 0 {
            w.write([]char(" -> "))
            if v.returns.count > 1 {
                w.write([]char("("))
            }

            for i := 0; i < v.returns.count; i += 1 {
                if i > 0 {
                    w.write([]char(", "))
                }
                write_type(w, v.returns[i])
            }

            if v.returns.count > 1 {
                w.write([]char(")"))
            }
        }

    case Type_Info_Enumeration
        w.write([]char("enum "))
        write_type(w, v.underlying)
        w.write([]char(" {"))
        if v.names.count != 0 {
            w.write([]char(" "))
            for i := 0; i < v.names.count; i += 1 {
                if i != 0 {
                    w.write([]char("; "))
                }

                wprint(w, "\{v.names[i]} = \{v.values[i]}")
            }
            w.write([]char(" "))
        }
        w.write([]char("}"))

    case Type_Info_Trait
        w.write([]char("trait {"))
        if v.names.count != 0 {
            w.write([]char(" "))
            for i := 0; i < v.names.count; i += 1 {
                if i != 0 {
                    w.write([]char("; "))
                }

                wprint(w, "\{v.names[i]}: \{v.types[i]}")
            }
            w.write([]char(" "))
        }
        w.write([]char("}"))

    case Type_Info_Union
        w.write([]char("union {"))
        if v.variants.count != 0 {
            w.write([]char(" "))
            for i := 0; i < v.variants.count; i += 1 {
                if i != 0 {
                    w.write([]char("; "))
                }

                write_type(w, v.variants[i])
            }
            w.write([]char(" "))
        }
        w.write([]char("}"))

    case Type_Info_Structure
        w.write([]char("struct {"))
        if v.names.count != 0 {
            w.write([]char(" "))
            for i := 0; i < v.names.count; i += 1 {
                if i != 0 {
                    w.write([]char("; "))
                }

                wprint(w, "\{v.names[i]}: \{v.types[i]}")
            }
            w.write([]char(" "))
        }
        w.write([]char("}"))

    case Type_Info_Array
        wprint(w, "[\{v.count}]\{v.underlying}")

    case Type_Info_Dynamic_Array
        wprint(w, "[..]\{v.underlying}")

    case Type_Info_Slice
        wprint(w, "[]\{v.underlying}")

    case Type_Info_String
        w.write([]char("string"))

    case null
        w.write([]char("null"))
    }
}

write_value :: (w: Writer, a: Any, nested: bool) {
    if a.type == Type {
        write_type(w, *&Type(a.data))
        return
    }

    if a.type == Interpolation {
        a := *&Interpolation(a.data)
        if a == {
        case []Any
            for i := 0; i < a.count; i += 1 {
                write_value(w, a[i], nested)
            }

        case string
            write_value(w, a, nested)

        case
            unreachable()
        }
        return
    }

    if a.type == Source_Code_Location {
        l := *&Source_Code_Location(a.data)
        wprint(w, "\{l.path}:\{l.row}:\{l.col}:")
        return
    }

    // TODO: Make the character and string printers respect special characters if nested
    v := a.type.variant
    if v == {
    case Type_Info_Boolean
        if *&bool(a.data) {
            w.write([]char("true"))
        } else {
            w.write([]char("false"))
        }

    case Type_Info_Character
        ch := *&char(a.data)
        if nested {
            w.write([]char("'"))
            if ch == '\'' {
                w.write([]char("\\'"))
            } else if ch == '\0' {
                w.write([]char("\\0"))
            } else {
                w.write((&ch)[..1])
            }
            w.write([]char("'"))
        } else {
            w.write((&ch)[..1])
        }

    case Type_Info_Integer
        buffer: [32]char
        count: i32
        if v.signed {
            if a.type.size == {
            case 1; count = C.snprintf(buffer.data, u64(buffer.count), "%d".data, *&i8(a.data))
            case 2; count = C.snprintf(buffer.data, u64(buffer.count), "%d".data, *&i16(a.data))
            case 4; count = C.snprintf(buffer.data, u64(buffer.count), "%d".data, *&i32(a.data))
            case 8; count = C.snprintf(buffer.data, u64(buffer.count), "%zd".data, *&i64(a.data))
            case; unreachable()
            }
        } else {
            if a.type.size == {
            case 1; count = C.snprintf(buffer.data, u64(buffer.count), "%u".data, *&u8(a.data))
            case 2; count = C.snprintf(buffer.data, u64(buffer.count), "%u".data, *&u16(a.data))
            case 4; count = C.snprintf(buffer.data, u64(buffer.count), "%u".data, *&u32(a.data))
            case 8; count = C.snprintf(buffer.data, u64(buffer.count), "%zu".data, *&u64(a.data))
            case; unreachable()
            }
        }
        w.write(buffer[..count])

    case Type_Info_Pointer, Type_Info_Function
        ptr := *&rawptr(a.data)
        if ptr == null {
            w.write([]char("null"))
        } else {
            buffer: [32]char
            count := C.snprintf(buffer.data, u64(buffer.count), "0x%zx".data, ptr)
            w.write(buffer[..count])
        }

    case Type_Info_Enumeration
        value: i64
        if v.underlying.size == {
        case 1; value = i64(*&i8(a.data))
        case 2; value = i64(*&i16(a.data))
        case 4; value = i64(*&i32(a.data))
        case 8; value = i64(*&i64(a.data))
        }

        for i := 0; i < v.values.count; i += 1 {
            if v.values[i] == value {
                w.write([]char(v.names[i]))
                return
            }
        }

        wprint(w, "(Invalid enum value: \{value})")

    case Type_Info_Trait
        t: Any
        t.type = *&Type(a.data)
        t.data = *&rawptr(a.data + rawptr(8))
        if t.type == null {
            w.write([]char("null"))
        } else {
            write_value(w, t, nested)
        }

    case Type_Info_Union
        tag := *&i64(a.data)
        if tag == 0 {
            w.write([]char("null"))
        } else if tag - 1 >= v.variants.count {
            wprint(w, "(Invalid union tag: \{tag})")
        } else {
            t: Any
            t.type = v.variants[tag - 1]
            t.data = a.data + rawptr(8)
            write_value(w, t, nested)
        }

    case Type_Info_Structure
        w.write([]char("{"))
        for i := 0; i < v.types.count; i += 1 {
            field: Any
            field.type = v.types[i]
            field.data = a.data + rawptr(v.offsets[i])
            if i != 0 {
                w.write([]char(", "))
            }
            write_value(w, field, true)
        }
        w.write([]char("}"))

    case Type_Info_Array
        w.write([]char("{"))
        for i := 0; i < v.count; i += 1 {
            if i != 0 {
                w.write([]char(", "))
            }

            item: Any
            item.type = v.underlying
            item.data = a.data + rawptr(i * v.underlying.size)
            write_value(w, item, true)
        }
        w.write([]char("}"))

    case Type_Info_Dynamic_Array
        count := *&i64(a.data + rawptr(8))
        data  := *&rawptr(a.data)

        w.write([]char("{"))
        for i := 0; i < count; i += 1 {
            if i != 0 {
                w.write([]char(", "))
            }

            item: Any
            item.type = v.underlying
            item.data = data + rawptr(i * v.underlying.size)
            write_value(w, item, true)
        }
        w.write([]char("}"))

    case Type_Info_Slice
        count := *&i64(a.data + rawptr(8))
        data  := *&rawptr(a.data)

        w.write([]char("{"))
        for i := 0; i < count; i += 1 {
            if i != 0 {
                w.write([]char(", "))
            }

            item: Any
            item.type = v.underlying
            item.data = data + rawptr(i * v.underlying.size)
            write_value(w, item, true)
        }
        w.write([]char("}"))

    case Type_Info_String
        s := *&string(a.data)
        if nested {
            w.write([]char("\""))
            for i := 0; i < s.count; i += 1 {
                ch := s[i]
                if ch == '"' {
                    w.write([]char("\\\""))
                } else {
                    w.write((&ch)[..1])
                }
            }
            w.write([]char("\""))
        } else {
            w.write([]char(s))
        }

    case null
        w.write([]char("null"))
    }
}
