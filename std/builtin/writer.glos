Writer :: trait {
    write: (bytes: []char)
}

wprint :: (w: Writer, vs: ...Any) {
    interpolating := 0
    for i := 0; i < vs.count; i += 1 {
        if interpolating != 0 {
            interpolating -= 1
        } else if i != 0 {
            w.write([]char(" "))
        }

        v := vs[i]
        if v.type == Interpolation_Marker {
            interpolating = i64(v.data)
            continue
        }

        if v == null {
            w.write([]char("null"))
        } else {
            write_value(w, v, false)
        }
    }
}

wprintln :: (w: Writer, vs: ...Any) {
    wprint(w, ...vs)
    wprint(w, '\n')
}

print :: (vs: ...Any) {
    wprint(os.stdout, ...vs)
}

println :: (vs: ...Any) {
    wprintln(os.stdout, ...vs)
}

eprint :: (vs: ...Any) {
    wprint(os.stderr, ...vs)
}

eprintln :: (vs: ...Any) {
    wprintln(os.stderr, ...vs)
}

#private
Interpolation_Marker :: distinct i64
