// Trait
Writer :: trait {
    write: (bytes: []char)
}

// Printing functions
wprint :: (w: Writer, vs: ...Any) {
    for i := 0; i < vs.count; i += 1 {
        v := vs[i]
        if v == null {
            w.write([]char("null"))
        } else {
            write_value(w, v, false)
        }

        // TODO: Print space in between arguments
    }
}

wprintln :: (w: Writer, vs: ...Any) {
    wprint(w, ...vs)
    wprint(w, '\n')
}

print :: (vs: ...Any) {
    wprint(os.stdout, ...vs)
}

println :: (vs: ...Any) {
    wprintln(os.stdout, ...vs)
}

eprint :: (vs: ...Any) {
    wprint(os.stderr, ...vs)
}

eprintln :: (vs: ...Any) {
    wprintln(os.stderr, ...vs)
}
