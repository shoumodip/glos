// Trait
Writer :: trait {
    write: (bytes: []char)
}

// Implementation of C FILE*
// TODO: These should in another module. Perhaps `io` or `os`
File :: distinct C.FILE

write :: (this: File, bytes: []char) {
    C.fwrite(rawptr(bytes.data), sizeof(char), bytes.count, C.FILE(this));
}

// Printing functions
wprint :: (w: Writer, vs: ...Any) {
    for i := 0; i < vs.count; i += 1 {
        v := vs[i]
        if v == null {
            w.write([]char("null"))
        } else {
            write_value(w, v, false)
        }

        // TODO: Print space in between arguments
    }
}

wprintln :: (w: Writer, vs: ...Any) {
    wprint(w, ...vs)
    wprint(w, '\n')
}

print :: (vs: ...Any) {
    wprint(File(C.stdout), ...vs)
}

println :: (vs: ...Any) {
    wprintln(File(C.stdout), ...vs)
}

eprint :: (vs: ...Any) {
    wprint(File(C.stderr), ...vs)
}

eprintln :: (vs: ...Any) {
    wprintln(File(C.stderr), ...vs)
}
