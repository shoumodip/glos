push :: (this: &[..]$T, v: T) {
    if this.count >= this.capacity {
        this.capacity *= 2
        if this.capacity == 0 {
            this.capacity = 128
        }

        this.data = &T(C.realloc(rawptr(this.data), this.capacity * sizeof(T)))
        assert(this.data != null)
    }

    *(this.data + &T(this.count * sizeof(T))) = v
    this.count += 1
}

free :: (this: &[..]$T) {
    C.free(rawptr(this.data))
    C.memset(rawptr(this), 0, sizeof(*this))
}
