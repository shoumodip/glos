// This file defines the contract between the compiler and source code.
//
// The compiler recognizes and depends on the declarations in this file.
// Modifying names, layouts, enum values, or semantics may cause compiler
// features to malfunction or produce undefined behavior.
//
// This file is intended to be kept in sync with the compiler's internal
// contract definitions.

// Platform
Platform :: enum {
    LINUX
    MACOS
    WINDOWS
}

PLATFORM :: #platform

// RTTI
Type :: &Type_Info

Type_Info :: struct {
    size: i64
    align: i64

    name: string
    variant: union {
        Type_Info_Boolean
        Type_Info_Character
        Type_Info_Integer
        Type_Info_Pointer
        Type_Info_Function
        Type_Info_Enumeration
        Type_Info_Trait
        Type_Info_Union
        Type_Info_Structure
        Type_Info_Array
        Type_Info_Slice
        Type_Info_String
    }

    id: i64
}

Type_Info_Boolean :: struct {}
Type_Info_Character :: struct {}

Type_Info_Integer :: struct {
    signed: bool
}

Type_Info_Pointer :: struct {
    underlying: Type
}

Type_Info_Function :: struct {
    args:    []Type
    returns: []Type

    // TODO: Variadics
}

Type_Info_Enumeration :: struct {
    names:      []string
    values:     []i64
    underlying: Type
}

Type_Info_Trait :: struct {
    names: []string
    types: []Type
}

Type_Info_Union :: struct {
    variants: []Type
}

Type_Info_Structure :: struct {
    names:   []string
    types:   []Type
    offsets: []i64
}

Type_Info_Array :: struct {
    underlying: Type
    count: i64
}

Type_Info_Slice :: struct {
    underlying: Type
}

Type_Info_String :: struct {}

// Builtin compound types
Any :: trait {}

Source_Code_Location :: struct {
    path: string
    row: i64
    col: i64
}

// Comparisons
Ordering :: enum {
    LT = -1
    EQ =  0
    GT =  1
}

Equivalence :: enum {
    EQ = 0
    NE = 1
}

#assert(i64(Ordering.EQ) == i64(Equivalence.EQ))
