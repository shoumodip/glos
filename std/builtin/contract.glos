// This file defines the contract between the compiler and source code.
//
// The compiler recognizes and depends on the declarations in this file.
// Modifying names, layouts, enum values, or semantics may cause compiler
// features to malfunction or produce undefined behavior.
//
// This file is intended to be kept in sync with the compiler's internal
// contract definitions.

// Platform
Platform :: enum {
    LINUX
    MACOS
    WINDOWS
}

PLATFORM :: #platform

// RTTI
Type :: distinct &Type_Info

Type_Info :: struct {
    size: s64
    align: s64

    name: string
    variant: union {
        Type_Info_Boolean
        Type_Info_Character
        Type_Info_Integer
        Type_Info_Float
        Type_Info_Pointer
        Type_Info_Function
        Type_Info_Enumeration
        Type_Info_Trait
        Type_Info_Union
        Type_Info_Structure
        Type_Info_Array
        Type_Info_Dynamic_Array
        Type_Info_Slice
        Type_Info_String
    }
}

Type_Info_Boolean :: struct {}
Type_Info_Character :: struct {}

Type_Info_Integer :: struct {
    signed: bool
}

Type_Info_Float :: struct {}

Type_Info_Pointer :: struct {
    underlying: Type
}

Type_Info_Function :: struct {
    args:      []Type
    returns:   []Type
    variadics: enum {
        NONE
        TYPED
        UNTYPED
    }
}

Type_Info_Enumeration :: struct {
    names:      []string
    values:     []s64
    underlying: Type
}

Type_Info_Trait :: struct {
    names: []string
    types: []Type
}

Type_Info_Union :: struct {
    variants: []Type
}

Type_Info_Structure :: struct {
    names:     []string
    types:     []Type
    offsets:   []s64
    monomorph: bool
}

Type_Info_Array :: struct {
    underlying: Type
    count: s64
}

Type_Info_Dynamic_Array :: struct {
    underlying: Type
}

Type_Info_Slice :: struct {
    underlying: Type
}

Type_Info_String :: struct {}

// Source Code Location
Source_Code_Location :: struct {
    path: string
    row: s64
    col: s64
}

// Interpolation
Interpolation :: union {
    []Any
    string
}

// Panic
Panic :: enum {
    INDEX_OUT_OF_BOUNDS       // (index: s64, count: s64)
    RANGE_OUT_OF_BOUNDS       // (begin: s64, end: s64, count: s64)
    RANGE_BEGIN_MORE_THAN_END // (begin: s64, end: s64)
    NULL_TRAIT_METHOD_ACCESS  // ()
    TRAIT_TYPE_MISMATCH       // (actual: Type, expected: Type)
    UNION_TYPE_MISMATCH       // (actual: s64, expected: s64, type: Type)
    INVALID_ENUM_VALUE        // (value: s64, signed: s64)
    INVALID_UNION_TAG         // (value: s64)
}

// Comparisons
Ordering :: enum {
    LT = -1
    EQ =  0
    GT =  1
}

// Builtin Traits
Any :: trait {}

Add :: trait($T: Type) {
    add: (other: T) -> T
}

Sub :: trait($T: Type) {
    sub: (other: T) -> T
}

Mul :: trait($T: Type) {
    mul: (other: T) -> T
}

Div :: trait($T: Type) {
    div: (other: T) -> T
}

Mod :: trait($T: Type) {
    mod: (other: T) -> T
}

Neg :: trait($T: Type) {
    neg: () -> T
}

Equal :: trait($T: Type) {
    equal: (other: T) -> bool
}

Ordered :: trait($T: Type) {
    order: (other: T) -> Ordering
}
