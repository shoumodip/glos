Arena :: struct {
    data:     rawptr
    head:     s64
    capacity: s64
}

impl Arena {
    alloc :: (a: &Arena, size: s64, align := true, zeroed := true, location := #caller_location) -> rawptr {
        if a.data == null {
            if a.capacity == 0 {
                a.capacity = 256 * 1024 * 1024
            }

            #if PLATFORM == .WINDOWS {
                a.data = C.VirtualAlloc(null, u64(a.capacity), C.MEM_RESERVE | C.MEM_COMMIT, C.PAGE_READWRITE)
            } else {
                a.data = C.mmap(null, u64(a.capacity), C.PROT_READ | C.PROT_WRITE, C.MAP_PRIVATE | C.MAP_ANONYMOUS, -1, 0)
                if a.data == C.MAP_FAILED {
                    a.data = null
                }
            }

            assert(a.data != null)
        }

        ptr := a.data + rawptr(a.head)
        if size == 0 {
            return ptr
        }

        if align {
            size = (size + 7) & -8
        }

        if a.head + size > a.capacity {
            panic("Arena overflow", location = location)
        }
        a.head += size

        if zeroed {
            C.memset(ptr, 0, u64(size))
        }
        return ptr
    }

    free :: (a: &Arena) {
        if a.data == null {
            return
        }

        #if PLATFORM == .WINDOWS {
            C.VirtualFree(a.data, 0, C.MEM_RELEASE)
        } else {
            C.munmap(a.data, u64(a.capacity))
        }

        C.memset(rawptr(a), 0, sizeof(*a))
    }

    reset :: (a: &Arena, ptr: rawptr, align := true, location := #caller_location) {
        if ptr < a.data || ptr > a.data + rawptr(a.head) {
            panic("Arena does not contain the memory address \{ptr}", location = location)
        }

        a.head = s64(ptr - a.data)
        if align {
            a.head = (a.head + 7) & -8
        }
    }
}

default: Arena
temporary := Arena { capacity = 16 * 1024 * 1024 }

C :: #import "C"
