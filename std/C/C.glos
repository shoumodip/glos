FILE :: distinct rawptr

extern {
    printf :: (fmt: &char, ...) -> i32
    fprintf :: (f: FILE, fmt: &char, ...) -> i32
    snprintf :: (out: &char, size: i64, fmt: &char, ...) -> i32
    fwrite :: (ptr: rawptr, size: i64, count: i64, f: FILE)
    fflush :: (f: FILE)
    abort :: ()
    exit :: (code: i32)
    memcmp :: (a: rawptr, b: rawptr, n: i64) -> i32
}

#if PLATFORM == {
case .LINUX
    extern {
        stdin: FILE
        stdout: FILE
        stderr: FILE
    }

case .MACOS
    extern {
        #link "__stdinp"  stdin: FILE
        #link "__stdoutp" stdout: FILE
        #link "__stderrp" stderr: FILE
    }

case .WINDOWS
    stdin: FILE
    stdout: FILE
    stderr: FILE
}
